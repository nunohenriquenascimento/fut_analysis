# Replace placeholders locally. URL-encode special characters in credentials.
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/ccdr_match_tracker
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Local HTTP only. Production HTTPS must set this to true (__Host- cookie).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
APP_ENV=development
AUTH_DEBUG_LOGGING=false
AUTH_SESSION_HOURS=8
# Isolated Ollama client; the model must already be available on that server.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_THINK=false
# Optional transport/response bounds:
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_MAX_RESPONSE_BYTES=1048576
