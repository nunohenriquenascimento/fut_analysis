# Replace placeholders locally. URL-encode special characters in credentials.
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/ccdr_match_tracker
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Local HTTP only. Production HTTPS must set this to true (__Host- cookie).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
APP_ENV=development
AUTH_SESSION_HOURS=8
