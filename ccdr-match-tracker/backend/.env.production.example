# Reference only: Railway uses dashboard variables, not this filename.
APP_ENV=production
AUTH_DEBUG_LOGGING=false
# In Railway set DATABASE_URL=${{Postgres.DATABASE_URL}} (actual service name).
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_PRIVATE_HOST:5432/railway
CORS_ORIGINS=["https://YOUR_FRONTEND.vercel.app"]
AUTH_COOKIE_SECURE=true
# Cross-site vercel.app -> up.railway.app. Requires third-party cookies allowed.
# With app.example.pt + api.example.pt, use lax instead.
AUTH_COOKIE_SAMESITE=none
AUTH_SESSION_HOURS=8
# PORT is injected by Railway. No fixed port required.
