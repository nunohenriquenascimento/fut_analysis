# Set in Railway's combined application service; not loaded from this file.
APP_ENV=production
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_PRIVATE_HOST:5432/railway
CORS_ORIGINS=["https://YOUR_DOMAIN.up.railway.app"]
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_HOURS=8
AUTH_DEBUG_LOGGING=false
# Railway injects PORT (normally 8080). Internal ports 3000 and 8000 reserved.
# NEXT_PUBLIC_API_URL=/api is fixed in the Docker build, not a runtime variable.
